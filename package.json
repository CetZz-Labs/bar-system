{
  "name": "bar-system",
  "private": true,
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "dev:web": "pnpm --filter @bar/client dev",
    "dev:api": "pnpm --filter @bar/server dev",
    "build": "pnpm -r build",
    "build:web": "pnpm --filter @bar/client build",
    "build:api": "pnpm --filter @bar/server build",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test"
  },
  "engines": {
    "node": ">=18"
  }
}
