# Graphify AST graphs (regenerable; not SSOT — see ../graphify/README.md)
graphify-out/

# AI agent harness — per-developer working memory. Only progress/history.md
# and progress/current.template.md are shared/tracked; everything else
# (current.md, explorers/, implementers/, reviewers/) is local evidence.
progress/*
!progress/history.md
!progress/current.template.md

# AI tool config — local per-developer, not shared
.opencode/
opencode.json
