DATABASE_URL=mongodb://127.0.0.1:27017/bar-system
JWT_SECRET=dev-secret-change-me
FRONTEND_URL=http://localhost:5173
PORT=3000
NODE_ENV=development
# EMAIL_USER=
# EMAIL_PASSWORD=

# LB-80 — Web Push (VAPID). Par de DESARROLLO generado con
# `npx web-push generate-vapid-keys`. Regenerar para cada entorno real;
# nunca reutilizar este par fuera de local. Si falta cualquiera de las 3,
# el envío push queda deshabilitado (no rompe el arranque ni los requests).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
