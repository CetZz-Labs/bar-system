DATABASE_URL=mongodb://127.0.0.1:27017/bar-system
JWT_SECRET=dev-secret-change-me
FRONTEND_URL=http://localhost:5173
PORT=3000
NODE_ENV=development

# --- Deploy (Render) ---
# En el entorno real de Render, setear:
#   NODE_ENV=production
#   CLOUDINARY_FOLDER=labanda/prod
# Render inyecta PORT automáticamente; el server bindea a 0.0.0.0 sin host explícito.

# FRONTEND_URL admite una LISTA separada por comas de orígenes exactos
# permitidos por CORS (HTTP + WebSocket). Se hace trim de cada valor y se
# descartan los vacíos. Ejemplo multi-dominio:
#   FRONTEND_URL=https://labanda.app,https://www.labanda.app

# CORS_PREVIEW_ORIGIN_REGEX (opcional): si se setea, se compila a RegExp y
# cualquier Origin que matchee se acepta ADEMÁS de la lista exacta de
# FRONTEND_URL. Pensado para las preview URLs cambiantes de Vercel. Si no se
# setea, solo se aceptan los orígenes exactos de FRONTEND_URL.
# CORS_PREVIEW_ORIGIN_REGEX=^https://la-banda-[a-z0-9-]+\.vercel\.app$

# SALT_ROUNDS (opcional): rondas de bcrypt para el hash de contraseñas.
# El código tiene fallback `|| 10` en utils/auth.ts, así que puede omitirse.
SALT_ROUNDS=10

# EMAIL_USER / EMAIL_PASSWORD: OBLIGATORIAS en producción para el flujo de
# emails (confirmación de registro / reset de contraseña) que usa nodemailer
# con service:'gmail'. EMAIL_PASSWORD debe ser un App Password de Gmail, no la
# contraseña de la cuenta. Sin estas vars el arranque no rompe, pero el envío
# de emails falla.
EMAIL_USER=
EMAIL_PASSWORD=

# LB-80 — Web Push (VAPID). Par de DESARROLLO generado con
# `npx web-push generate-vapid-keys`. Regenerar para cada entorno real;
# nunca reutilizar este par fuera de local. Si falta cualquiera de las 3,
# el envío push queda deshabilitado (no rompe el arranque ni los requests,
# ver utils/pushService.ts).
# NOTA (LB-102): el push queda POSPUESTO en este ticket; en producción se puede
# desplegar sin estas vars y habilitarlo más adelante.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Cloudinary — credenciales del Dashboard (Settings → API Keys).
# CLOUDINARY_FOLDER separa los assets por entorno (labanda/dev vs labanda/prod).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=labanda/dev
